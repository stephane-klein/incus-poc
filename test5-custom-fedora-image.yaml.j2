kind: instance
name: test5-lxc
image: fedora-44-sklein-container
profiles:
  - default
devices:
  volume1:
    type: disk
    source: ./volumes/volume1
    path: /mnt/volume1
config:
  security.nesting: "true"
  cloud-init.user-data: |
    #cloud-config
    hostname: test5-lxc
    fqdn: test5-lxc.homelab.stephane-klein.info
    prefer_fqdn_over_hostname: true
    create_hostname_file: true
    write_files:
      - path: /tmp/netbird-setup-key
        content: {{ ENV.NETBIRD_SETUP_KEY }}
        permissions: "0600"
    runcmd:
      - [bash, /usr/local/sbin/enroll-netbird.sh, /tmp/netbird-setup-key]
    users:
      - name: fedora
        ssh_authorized_keys:
          - ssh-rsa  contact@stephane-klein.info
---
kind: instance
name: test5-vm
image: fedora-44-sklein-vm
vm: true
profiles:
  - default
devices:
  volume1:
    type: disk
    source: ./volumes/volume1
    path: /mnt/volume1
config:
  cloud-init.user-data: |
    #cloud-config
    hostname: test5-vm
    fqdn: test5-vm.homelab.stephane-klein.info
    prefer_fqdn_over_hostname: true
    create_hostname_file: true
    write_files:
      - path: /tmp/netbird-setup-key
        content: {{ ENV.NETBIRD_SETUP_KEY }}
        permissions: "0600"
    runcmd:
      - [bash, /usr/local/sbin/enroll-netbird.sh, /tmp/netbird-setup-key]
    users:
      - name: fedora
        ssh_authorized_keys:
          - ssh-rsa  contact@stephane-klein.info
